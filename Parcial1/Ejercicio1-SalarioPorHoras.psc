Proceso SalarioPorHoras
	Definir horas, tarifa, salario Como Real
	Escribir '=== Calculo de Salario por Horas ==='
	Escribir 'Ingrese las horas trabajadas: '
	Leer horas
	Escribir 'Ingrese la tarifa de pago por hora: '
	Leer tarifa
	salario <- horas*tarifa
	Escribir 'El salario a pagar es: ', salario
FinProceso
